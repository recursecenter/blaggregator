# Settings for local development.  Not secrets, so it's fine to commit.
#
# Used by docker-compose.yml.  Without Docker, tell uv to use it:
#     export UV_ENV_FILE=dev.env
#
# DJANGO_DEBUG turns on Django's debug mode.  DEV_LOGIN adds a "Log in as the dev
# user" button, so you don't need Recurse Center credentials.  The dev login
# only works with DJANGO_DEBUG set, and never when PROD or STAGING are set.
DJANGO_DEBUG=1
DEV_LOGIN=1
